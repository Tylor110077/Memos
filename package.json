{
  "name": "studyboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron electron/main.js\"",
    "electron:build": "cross-env NEXT_PUBLIC_API_MODE=direct next build && electron-builder",
    "electron:pack": "cross-env NEXT_PUBLIC_API_MODE=direct next build && electron-builder --dir"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/d3-force": "^3.0.10",
    "@xyflow/react": "^12.0.0",
    "ai": "^4.0.0",
    "cheerio": "^1.2.0",
    "d3-force": "^3.0.0",
    "date-fns": "^4.0.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.12.0",
    "nanoid": "^5.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.memos.app",
    "productName": "Memos",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "artifactName": "Memos-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Memos-${version}-win.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Memos-${version}-linux.${ext}"
    }
  }
}
